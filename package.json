{
  "name": "svg-canvas",
  "version": "0.1.0",
  "description": "SVG canvas library for rendering and interacting with SVG graphics",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "lint:styles": "stylelint 'src/**/*.css'",
    "lint:styles:fix": "stylelint 'src/**/*.css' --fix",
    "format": "prettier --write 'src/**/*.{ts,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,css}'",
    "typecheck": "tsc --noEmit",
    "example": "vite serve examples/",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-custom-rules": "file:./eslint-plugin-custom-rules",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-prettier": "^5.0.2",
    "tsup": "^8.2.4",
    "tsx": "^4.22.4",
    "typescript": "^5.5.4",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "canvas-dither": "^1.0.1",
    "clipper-lib": "^6.4.2",
    "omnifont": "^0.1.0",
    "svg-path-outline": "^1.0.1"
  }
}
